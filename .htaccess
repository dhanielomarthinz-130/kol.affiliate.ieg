# .htaccess
# Batas upload video. Direktif php_value hanya berlaku pada Apache mod_php (XAMPP);
# dibungkus IfModule agar tidak menyebabkan "500 Internal Server Error" di hosting
# yang menjalankan PHP sebagai CGI/FPM (di sana atur lewat php.ini / .user.ini).
<IfModule mod_php.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
    php_value memory_limit 512M
</IfModule>

# Enable correct MIME types for video streaming
AddType video/webm .webm
AddType video/mp4 .mp4
AddType video/ogg .ogv

# Prevent directory indexing
Options -Indexes

# Custom 404 Error Document
ErrorDocument 404 404.php

# URL Rewriting for Clean URLs (Remove .php)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect InfinityFree live domain to ngrok public tunnel
    RewriteCond %{HTTP_HOST} ^(www\.)?iegkolaffiliate\.great-site\.net [NC,OR]
    RewriteCond %{HTTP_HOST} great-site\.net$ [NC]
    RewriteRule ^(.*)$ https://unmoving-faculty-bok.ngrok-free.dev/$1 [R=302,L,NE]

    # 1. Redirect external GET/HEAD requests with .php to clean URL (Exclude /api/ and only for GET/HEAD)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} !/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. Internally forward clean URLs to .php file if it exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]

    # 3. Route non-existent paths to 404.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php !-f
    RewriteRule ^ 404.php [L]
</IfModule>
