# .htaccess
php_value upload_max_filesize 100M
php_value post_max_size 100M
php_value max_execution_time 300
php_value max_input_time 300

# Enable correct MIME types for video streaming
AddType video/webm .webm
AddType video/mp4 .mp4
AddType video/ogg .ogv

# Prevent directory indexing
Options -Indexes

# URL Rewriting for Clean URLs (Remove .php)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirect external GET/HEAD requests with .php to clean URL (Exclude /api/ and only for GET/HEAD)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} !/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. Internally forward clean URLs to .php file if it exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
